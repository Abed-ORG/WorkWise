generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DEVELOPER
  VIEWER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_MOVED
  COMMENT_ADDED
  MENTION
  SPRINT_STARTED
  SPRINT_COMPLETED
}

enum NotificationPreference {
  ALL
  MENTIONS_ONLY
  NONE
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  onboardingDismissed Boolean  @default(false)
  notificationPreference NotificationPreference @default(ALL)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  projectMembers      ProjectMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  comments            Comment[]
  taskActivities      TaskActivity[]
  timeLogs            TimeLog[]
  projectActivities   ProjectActivity[]
  notifications       Notification[]
  documents           Document[]
  invitationsSent     Invitation[]         @relation("InvitationSender")
  passwordResetTokens PasswordResetToken[]
  generatedDigests    DailyDigest[]        @relation("DailyDigestGenerator")
  generatedRetros     SprintRetrospective[] @relation("SprintRetroGenerator")

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  key         String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  tasks       Task[]
  sprints     Sprint[]
  documents   Document[]
  invitations Invitation[]
  activities  ProjectActivity[]
  dailyDigests DailyDigest[]
  retrospectives SprintRetrospective[]

  @@index([updatedAt])
  @@map("projects")
}

model ProjectMember {
  id       String   @id @default(cuid())
  role     Role     @default(DEVELOPER)
  joinedAt DateTime @default(now())

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId, role])
  @@map("project_members")
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  documents SprintDocument[]
  retrospective SprintRetrospective?

  @@index([projectId, isActive])
  @@index([projectId, startDate])
  @@index([projectId, endDate])
  @@map("sprints")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  acceptanceCriteria String?
  estimatedHours Float?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  labels      String[]
  dueDate     DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId  String
  sprintId   String?
  assigneeId String?
  creatorId  String

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint     Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee   User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User           @relation("TaskCreator", fields: [creatorId], references: [id])
  comments   Comment[]
  activities TaskActivity[]
  documents  TaskDocument[]
  checklistItems TaskChecklistItem[]
  attachments Attachment[]
  timeLogs TimeLog[]

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([projectId, updatedAt])
  @@index([projectId, createdAt])
  @@index([sprintId, status])
  @@index([assigneeId, status])
  @@index([assigneeId, updatedAt])
  @@map("tasks")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  text      String
  completed Boolean  @default(false)
  order     Int

  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@map("task_checklist_items")
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  storageKey String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("attachments")
}

model TimeLog {
  id              String   @id @default(cuid())
  durationMinutes Int
  description     String?
  createdAt       DateTime @default(now())

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@map("time_logs")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId   String
  authorId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model TaskActivity {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@map("task_activities")
}

model Document {
  id        String   @id @default(cuid())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  authorId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
  tasks   TaskDocument[]
  sprints SprintDocument[]

  @@index([projectId, updatedAt])
  @@index([projectId, createdAt])
  @@index([authorId, updatedAt])
  @@map("documents")
}

model TaskDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId     String
  documentId String

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([taskId, documentId])
  @@index([documentId])
  @@map("task_documents")
}

model SprintDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sprintId   String
  documentId String

  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([sprintId, documentId])
  @@index([documentId])
  @@map("sprint_documents")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  role      Role             @default(DEVELOPER)
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  projectId String
  senderId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender  User    @relation("InvitationSender", fields: [senderId], references: [id])

  @@index([email, status])
  @@index([projectId, status])
  @@index([senderId, createdAt])
  @@map("invitations")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ProjectActivity {
  id        String   @id @default(cuid())
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())

  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_activities")
}

model DailyDigest {
  id              String   @id @default(cuid())
  title           String
  summary         String
  completedCount  Int      @default(0)
  inProgressCount Int      @default(0)
  blockerCount    Int      @default(0)
  source          String   @default("manual")
  createdAt       DateTime @default(now())

  projectId     String
  generatedById String?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation("DailyDigestGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("daily_digests")
}

model SprintRetrospective {
  id          String   @id @default(cuid())
  whatWentWell String
  whatDidnt    String
  actionItems  String
  manualNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projectId     String
  sprintId      String   @unique
  generatedById String?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  generatedBy User?   @relation("SprintRetroGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("sprint_retrospectives")
}

model AiQuotaUsage {
  date  String @id
  count Int    @default(0)

  @@map("ai_quota_usage")
}
