# =============================================================================
# WorkWise — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
#   cp server/.env.example server/.env
#
# Where to obtain credentials:
#   Supabase  → https://supabase.com/dashboard → your project → Settings → Database
#   Gemini    → https://aistudio.google.com/app/apikey
#   Gmail     → Google Account → Security → App Passwords (requires 2FA)
#   Resend    → https://resend.com/api-keys
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------

# Transaction-mode pooler — used by the app at runtime (port 6543, pgBouncer).
# Supabase dashboard → Settings → Database → Connection string → Transaction mode.
# Must include ?pgbouncer=true at the end.
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used by Prisma CLI for migrations and Prisma Studio (port 5432).
# Supabase dashboard → Settings → Database → Connection string → Session mode.
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase (optional — only needed if calling Supabase REST/Auth APIs directly,
# and required for the Supabase Storage attachment uploads described below)
# -----------------------------------------------------------------------------

# Project URL. Supabase dashboard → Settings → API → Project URL.
SUPABASE_URL="https://your-project-ref.supabase.co/rest/v1/"

# Anon/public key — safe to expose to clients. Settings → API → Project API keys.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"

# Service role / secret key — server-side only, never expose to the browser.
# Settings → API → Project API keys → service_role.
# Also used server-side to read/write the attachments bucket below.
SUPABASE_SECRET_KEY="sb_secret_your_key_here"

# Storage bucket that holds new task attachments (object-storage migration).
# Supabase dashboard → Storage → Create bucket. Recommend keeping it PRIVATE —
# the server uses the service role key above to read/write/delete objects, and
# attachment access is gated by the app's own project-membership checks, not by
# bucket-level public access. Without this set, new attachment uploads will fail
# with a 503 (existing base64 attachments keep working regardless).
SUPABASE_ATTACHMENTS_BUCKET="task-attachments"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------

# Secret used to sign access tokens. Generate with: openssl rand -hex 64
JWT_SECRET="replace_with_a_long_random_string_at_least_64_chars"

# Secret used to sign refresh tokens. Use a different value from JWT_SECRET.
JWT_REFRESH_SECRET="replace_with_a_different_long_random_string_at_least_64_chars"

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------

# Google Gemini API key. Google AI Studio → Get API key.
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"

# Optional daily digest scheduler. Leave disabled for local demos/manual testing.
DAILY_DIGEST_SCHEDULER_ENABLED=false

# Hour in UTC when scheduled digests should be generated if enabled.
DAILY_DIGEST_HOUR_UTC=18

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Port the Express server listens on. Render sets this automatically in production.
PORT=3000

# Node environment. Use "development" locally, "production" on Render.
NODE_ENV="development"

# URL of the frontend app. Used for CORS and email reset links.
# Local: http://localhost:5173 | Production: your Vercel deployment URL.
FRONTEND_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Email — SMTP (primary, uses the mentor-provided Gmail mailbox)
# -----------------------------------------------------------------------------

# SMTP hostname. For Gmail: smtp.gmail.com
SMTP_HOST="smtp.gmail.com"

# SMTP port. 587 for STARTTLS (recommended), 465 for SSL.
SMTP_PORT=587

# Set to true only when using port 465 (SSL). Leave false for port 587 (STARTTLS).
SMTP_SECURE=false

# Gmail address used as the sender. Must match the App Password below.
SMTP_USER="your-gmail-address@gmail.com"

# Google App Password (NOT your Gmail password).
# Google Account → Security → 2-Step Verification → App Passwords.
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Display name and address shown in the From: header.
MAIL_FROM="WorkWise <your-gmail-address@gmail.com>"

# -----------------------------------------------------------------------------
# Email — Resend (optional fallback transactional email service)
# -----------------------------------------------------------------------------

# Resend API key. Leave empty to disable Resend and use SMTP instead.
RESEND_API_KEY="re_your_resend_api_key_here"

# From address for Resend-delivered emails.
EMAIL_FROM="WorkWise <onboarding@resend.dev>"
